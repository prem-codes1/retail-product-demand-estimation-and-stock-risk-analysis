# =====================================================================
# Stockout Risk Predictor - Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================================

# -------------------------------------------------
# Server
# -------------------------------------------------
PORT=3001

# -------------------------------------------------
# Live Warehouse Stock Integration
# -------------------------------------------------
# Provider: "mock" (default), "rest", or "database" (future)
STOCK_PROVIDER=mock

# REST API provider settings (when STOCK_PROVIDER=rest)
WMS_BASE_URL=https://your-wms.example.com/api
WMS_API_KEY=your-wms-api-key
WMS_TIMEOUT_MS=5000
WMS_CACHE_TTL_MS=60000

# -------------------------------------------------
# Gemini AI - Demand Forecast Explainability
# -------------------------------------------------
# Get your API key from: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Model: gemini-3.5-flash-lite (fast, efficient) or gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Rate limit: requests per minute (prevents quota exhaustion)
GEMINI_RATE_LIMIT=30
